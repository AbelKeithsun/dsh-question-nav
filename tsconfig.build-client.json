{
  // Client declaration emit: lib/types/client/** + lib/types/core/**.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/core/**/*.ts"
  ]
}
