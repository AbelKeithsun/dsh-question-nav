{
  // Self-contained compiler settings: types resolve from the @deepseek-ai/*
  // npm SDK packages declared in devDependencies (official NPM SDK), never
  // from a DSH source checkout. Shared by the host and client programs —
  // they MUST stay separate because @deepseek-ai/dsh-session (host) and
  // @deepseek-ai/dsh-client-runtime (browser) both merge `Context.sessions`
  // with incompatible service types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": []
  }
}
